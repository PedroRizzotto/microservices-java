# Copie este arquivo para .env (na mesma pasta) e troque os valores.
# O .env nao vai para o git.

# Usuario e senha dos bancos PostgreSQL (usados pelos containers e pelos servicos)
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Chave que assina e valida o JWT (auth-api e gateway-api). Minimo de 32 caracteres.
# Para gerar uma: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Login do Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
